{
  "name": "dsh-agent-browser-auto",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 桌面版 Agent 浏览器：默认轻量内嵌，可显式切换独立 profile 的真实 Chrome/Edge；统一 browser_* 工具（20 个）支持快照、输入、上传、对话框、等待与 CDP 深度模式。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/66jiujiu99/dsh-agent-browser-auto.git"
  },
  "homepage": "https://github.com/66jiujiu99/dsh-agent-browser-auto#readme",
  "bugs": {
    "url": "https://github.com/66jiujiu99/dsh-agent-browser-auto/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tools/",
    "README.md",
    "PROTOCOL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "browser",
    "webview",
    "automation",
    "cdp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
