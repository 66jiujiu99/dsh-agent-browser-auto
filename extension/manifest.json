{
  "manifest_version": 3,
  "name": "DSH Agent 浏览器桥",
  "short_name": "DSH Bridge",
  "version": "0.8.0",
  "description": "把日常浏览器的真实标签页交给 DSH agent 操作：loopback WebSocket + token 配对，不开调试端口、没有授权弹窗。",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "offscreen", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "pair.html",
    "default_title": "DSH Agent 浏览器桥：点击配对"
  }
}
